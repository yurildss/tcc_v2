   "source": [
    "# 1. Limpa a pasta de trabalho (caso o Kaggle tenha deixado lixo de execuções passadas)\n",
    "!rm -rf /kaggle/working/*\n",
    "\n",
    "# 2. Baixa o código mais recente e atualizado direto do seu GitHub\n",
    "!git clone https://github.com/yurildss/tcc_v2.git /kaggle/working/tcc_v2\n",
    "\n",
    "# 3. Entra na pasta do projeto recém-baixada\n",
    "%cd /kaggle/working/tcc_v2\n",
    "\n",
    "# 4. Avisa ao Python onde é a raiz do projeto (para não dar erro no src)\n",
    "%env PYTHONPATH=/kaggle/working/tcc_v2\n",
    "\n",
    "# 5. Instala as bibliotecas necessárias\n",
    "!pip install -r requirements.txt"
   ]
  }
